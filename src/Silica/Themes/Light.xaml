<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Window">#F3F4F7</Color>
    <Color x:Key="C.Sidebar">#EBEDF1</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F6F7FA</Color>
    <Color x:Key="C.Hover">#E9ECF1</Color>
    <Color x:Key="C.Pressed">#DFE3EA</Color>
    <Color x:Key="C.Stroke">#E1E4EA</Color>
    <Color x:Key="C.StrokeStrong">#CDD2DB</Color>
    <Color x:Key="C.Text">#14181F</Color>
    <Color x:Key="C.Text2">#596271</Color>
    <Color x:Key="C.Text3">#8A93A1</Color>
    <Color x:Key="C.Track">#E4E7ED</Color>
    <Color x:Key="C.Grid">#ECEEF2</Color>
    <Color x:Key="C.Success">#1E9E66</Color>
    <Color x:Key="C.Warning">#C7860E</Color>
    <Color x:Key="C.Danger">#D93A34</Color>
    <Color x:Key="C.Shadow">#5A6478</Color>
    <Color x:Key="C.Scrim">#66101418</Color>
    <Color x:Key="C.Selection">#2E3366FF</Color>

    <Color x:Key="C.Series1">#2F6FEB</Color>
    <Color x:Key="C.Series2">#14A391</Color>
    <Color x:Key="C.Series3">#D08A0E</Color>
    <Color x:Key="C.Series4">#D2477E</Color>
    <Color x:Key="C.Series5">#7A57EA</Color>
    <Color x:Key="C.Series6">#2496D3</Color>
    <Color x:Key="C.Series7">#DB6A25</Color>
    <Color x:Key="C.Series8">#5FA830</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource C.Stroke}" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="{StaticResource C.StrokeStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource C.Track}" />
    <SolidColorBrush x:Key="Brush.Grid" Color="{StaticResource C.Grid}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1A1E9E66" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#1FC7860E" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#1AD93A34" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource C.Selection}" />
    <SolidColorBrush x:Key="Brush.Scrollbar" Color="#C3C8D1" />
    <SolidColorBrush x:Key="Brush.ScrollbarHover" Color="#A9B0BC" />
    <SolidColorBrush x:Key="Brush.Tooltip" Color="#FFFFFF" />
</ResourceDictionary>
