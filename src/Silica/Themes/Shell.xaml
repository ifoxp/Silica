<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Silica.Controls"
                    xmlns:l="clr-namespace:Silica.Localization">

    <c:BoolToVisibility x:Key="VisibleWhen" />
    <c:BoolToVisibility x:Key="HiddenWhen" Invert="True" />
    <c:NullToVisibility x:Key="VisibleIfAny" />
    <l:TranslateConverter x:Key="Tr" />

    <!-- Sidebar navigation item -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}"
                                    HorizontalAlignment="Left" Visibility="Hidden" />
                            <TextBlock x:Name="Ico" Text="{TemplateBinding c:Ui.Icon}" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                       Style="{StaticResource Text.Base}" Foreground="{TemplateBinding Foreground}"
                                       Visibility="{Binding (c:Ui.Compact), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HiddenWhen}}" />
                            <Border Grid.Column="2" x:Name="Badge" Background="{DynamicResource Brush.AccentSubtle}" CornerRadius="8" Padding="6,1" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Text="{TemplateBinding c:Ui.Badge}" FontSize="12" Foreground="{DynamicResource Brush.AccentText}" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="c:Ui.Badge" Value="{x:Null}">
                            <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="c:Ui.Compact" Value="False" />
                            </MultiTrigger.Conditions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar group header that folds its pages away -->
    <Style x:Key="NavGroup" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,12,10,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="12,0,10,0">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="Turn" Angle="-90" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Text.Overline}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box in the title bar -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Padding" Value="34,0,64,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style x:Key="CellText" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="False" />
    </Style>

    <!-- Key/value line in property cards -->
    <Style x:Key="PropLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Margin" Value="0,5,16,5" />
    </Style>
    <Style x:Key="PropValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="Margin" Value="0,5,0,5" />
    </Style>
</ResourceDictionary>
