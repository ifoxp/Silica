<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="C.Window">#0D0F13</Color>
    <Color x:Key="C.Sidebar">#111419</Color>
    <Color x:Key="C.Surface">#161A20</Color>
    <Color x:Key="C.SurfaceAlt">#1B2028</Color>
    <Color x:Key="C.Hover">#20262F</Color>
    <Color x:Key="C.Pressed">#272E39</Color>
    <Color x:Key="C.Stroke">#232933</Color>
    <Color x:Key="C.StrokeStrong">#323A47</Color>
    <Color x:Key="C.Text">#E8EBF0</Color>
    <Color x:Key="C.Text2">#9AA3B1</Color>
    <Color x:Key="C.Text3">#677181</Color>
    <Color x:Key="C.Track">#252C37</Color>
    <Color x:Key="C.Grid">#1F252E</Color>
    <Color x:Key="C.Success">#3CC98A</Color>
    <Color x:Key="C.Warning">#F0B54A</Color>
    <Color x:Key="C.Danger">#F2615B</Color>
    <Color x:Key="C.Shadow">#000000</Color>
    <Color x:Key="C.Scrim">#A0000000</Color>
    <Color x:Key="C.Selection">#334C8DFF</Color>

    <Color x:Key="C.Series1">#4C8DFF</Color>
    <Color x:Key="C.Series2">#36C9B4</Color>
    <Color x:Key="C.Series3">#F0B54A</Color>
    <Color x:Key="C.Series4">#E9699A</Color>
    <Color x:Key="C.Series5">#9C7CFF</Color>
    <Color x:Key="C.Series6">#58B8EC</Color>
    <Color x:Key="C.Series7">#F28A4B</Color>
    <Color x:Key="C.Series8">#8FD25E</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource C.Window}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource C.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource C.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource C.Pressed}" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource C.Stroke}" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="{StaticResource C.StrokeStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="Brush.Text2" Color="{StaticResource C.Text2}" />
    <SolidColorBrush x:Key="Brush.Text3" Color="{StaticResource C.Text3}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource C.Track}" />
    <SolidColorBrush x:Key="Brush.Grid" Color="{StaticResource C.Grid}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1F3CC98A" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#1FF0B54A" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="#1FF2615B" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource C.Scrim}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource C.Selection}" />
    <SolidColorBrush x:Key="Brush.Scrollbar" Color="#3A4250" />
    <SolidColorBrush x:Key="Brush.ScrollbarHover" Color="#4A5363" />
    <SolidColorBrush x:Key="Brush.Tooltip" Color="#232934" />
</ResourceDictionary>
