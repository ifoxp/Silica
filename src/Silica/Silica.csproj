<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Silica</AssemblyName>
    <RootNamespace>Silica</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Silica.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>Silica</Product>
    <Description>System information, sensors and benchmarks</Description>
    <Copyright>Copyright © 2026 Dmytro Chekaliuk</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <StartupObject>Silica.Program</StartupObject>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Silica.Core\Silica.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Languages\*.json" LogicalName="Silica.Languages.%(Filename)%(Extension)" />
    <Resource Include="Assets\Silica.ico" />
  </ItemGroup>

</Project>
