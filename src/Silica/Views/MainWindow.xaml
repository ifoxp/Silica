<Window x:Class="Silica.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Silica.Localization"
        xmlns:c="clr-namespace:Silica.Controls"
        Title="Silica" Width="1320" Height="840" MinWidth="900" MinHeight="580"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Icon="/Silica;component/Assets/Silica.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Background="{DynamicResource Brush.Sidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SidebarToggle" Style="{StaticResource Button.Icon}" Content="&#xE700;" Margin="10,0,4,0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleSidebar" ToolTip="{l:T 'Collapse sidebar'}" />
                <Image Source="/Silica;component/Assets/Silica.ico" Width="18" Height="18" Margin="6,0,10,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Silica" Style="{StaticResource Text.Base}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1" HorizontalAlignment="Center" Width="520" Margin="24,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="{l:T 'Search anything'}"
                         TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                         GotKeyboardFocus="OnSearchFocus" LostKeyboardFocus="OnSearchLostFocus" />
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                <Border HorizontalAlignment="Right" Margin="0,0,8,0" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource Brush.Text3}" />
                </Border>
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6"
                       AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                    <Border Width="{Binding ActualWidth, ElementName=SearchBox}" MaxHeight="520" Margin="0,0,12,12"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeStrong}"
                            BorderThickness="1" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="{DynamicResource C.Shadow}" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ListBox x:Name="SearchResults" Style="{StaticResource BareList}" Padding="6"
                                     PreviewMouseLeftButtonUp="OnSearchResultClick" />
                            <TextBlock x:Name="SearchEmpty" Margin="18,16" Style="{StaticResource Text.Secondary}" Visibility="Collapsed"
                                       Text="{l:T 'Nothing found. Try another word or check the spelling.'}" TextWrapping="Wrap" />
                            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="14,7">
                                <Grid>
                                    <TextBlock x:Name="SearchStatus" Style="{StaticResource Text.Caption}" />
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text3}"
                                               Text="{l:T 'Enter to open, Esc to close'}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Button.Caption}" Content="&#xE921;" Click="OnMinimize" AutomationProperties.Name="{l:T Minimize}" />
                <Button x:Name="MaxButton" Style="{StaticResource Button.Caption}" Content="&#xE922;" Click="OnMaximize" AutomationProperties.Name="{l:T Maximize}" />
                <Button Style="{StaticResource Button.CaptionClose}" Content="&#xE8BB;" Click="OnClose" AutomationProperties.Name="{l:T Close}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{DynamicResource Brush.Sidebar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="NavScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="NavPanel" Margin="0,4,0,12" />
                    </ScrollViewer>
                    <StackPanel Grid.Row="1" x:Name="NavFooter" Margin="0,6,0,10" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="AdminBanner" Visibility="Collapsed" Margin="28,18,28,0" Padding="14,10" CornerRadius="8"
                        Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Base}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="{l:T 'Limited mode: without administrator rights temperatures, fan speeds and drive health are not available.'}" />
                        <Button Grid.Column="2" Margin="16,0,0,0" Content="{l:T 'Restart as administrator'}" Click="OnRestartElevated" />
                    </Grid>
                </Border>
                <ContentControl x:Name="Host" Grid.Row="1" Focusable="False" />
                <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                        Background="{DynamicResource Brush.Tooltip}" BorderBrush="{DynamicResource Brush.StrokeStrong}" BorderThickness="1"
                        CornerRadius="8" Padding="16,9" Opacity="0" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.3" Color="{DynamicResource C.Shadow}" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                        <TextBlock x:Name="ToastText" Style="{StaticResource Text.Base}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
