<UserControl x:Class="Silica.Views.InfoPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Silica.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="28,22,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Brush.AccentSubtle}" Margin="0,0,14,0">
                <TextBlock x:Name="PageIcon" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.AccentText}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" />
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="220" Margin="0,0,8,0">
                    <TextBox x:Name="FilterBox" Tag="{l:T 'Filter this page'}" Padding="30,6,10,6" TextChanged="OnFilterChanged" />
                    <TextBlock Text="&#xE71C;" Style="{StaticResource Icon}" FontSize="12" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Click="OnCopyAll" ToolTip="{l:T 'Copy page as text'}" />
                <Button x:Name="ExportButton" Style="{StaticResource Button.Icon}" Content="&#xE74E;" Click="OnExport" ToolTip="{l:T 'Save page'}" />
                <Button x:Name="RefreshButton" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Click="OnRefresh" ToolTip="{l:T 'Refresh (F5)'}" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="Body" Margin="28,0,28,28" />
        </ScrollViewer>
    </Grid>
</UserControl>
