<Application x:Class="Silica.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Base.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Shell.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Brush.Accent" Color="#4C8DFF" />
            <SolidColorBrush x:Key="Brush.AccentHover" Color="#6A9FFF" />
            <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3F79DD" />
            <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#2A4C8DFF" />
            <SolidColorBrush x:Key="Brush.AccentText" Color="#7AAAFF" />
            <SolidColorBrush x:Key="Brush.OnAccent" Color="White" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
